rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'owner') ||
        ('email' in request.auth.token && request.auth.token.email == 'rupak2472@gmail.com')
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        isOwner() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'worker')
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isOwner());
      allow write: if isOwner() || (isAuthenticated() && request.auth.uid == userId);
    }

    // 2. Customers collection
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow create, update: if isStaff();
      allow delete: if isOwner();
    }

    // 3. Machine categories
    match /machine_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    // 4. Machines collection: Workers cannot modify base pricing
    match /machines/{machineId} {
      allow read: if isAuthenticated();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        isStaff() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['baseDailyRate', 'dailyRate', 'name', 'categoryId'])
      );
    }

    // 5. Job sheets collection: Immutable records. Delete is FORBIDDEN for everyone (including Owner)
    match /job_sheets/{jobSheetId} {
      allow read: if isAuthenticated();
      allow create: if isStaff() && (
        isOwner() || (request.resource.data.discount <= 200)
      );
      // Only allow transition to closed or adding remarks/settlements; cannot alter original rental terms
      allow update: if isStaff() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'customerId', 'customerName', 'customerPhone', 'machineId', 'rateUsed', 'checkoutTime', 'isDeleted']);
      allow delete: if false; // STRICTLY FORBIDDEN FOR ALL USERS
    }

    // 6. Payments collection: Immutable financial ledger
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update, delete: if false; // Financial records cannot be altered or deleted
    }

    // 7. Daily Cash collection: Owner can read all, staff can record daily balance
    match /daily_cash/{dateId} {
      allow read: if isOwner();
      allow write: if isStaff();
    }

    // 8. Activity log: Write-only-once. Deny update and delete entirely
    match /activity_log/{logId} {
      allow read: if isOwner();
      allow create: if isStaff();
      allow update, delete: if false;
    }
  }
}
